# Kopyala: cp .env.example .env  (yalnızca yerel geliştirme değerleri; .env gitignore'dadır)

# Postgres (docker-compose)
POSTGRES_USER=infulancer
POSTGRES_PASSWORD=change-me
POSTGRES_DB=infulancer
DATABASE_URL=postgresql://infulancer:change-me@localhost:5432/infulancer
AUDIT_DATABASE_URL=postgresql://infulancer:change-me@localhost:5432/infulancer_audit

# Auth.js
AUTH_SECRET=change-me-generate-with-openssl
AUTH_TRUST_HOST=true

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-central-1
S3_BUCKET=infulancer-assets
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me-min-8-chars
S3_FORCE_PATH_STYLE=true
PRESIGN_TTL_SECONDS=900

# LLM (mock | bedrock)
LLM_PROVIDER=mock
BEDROCK_REGION=eu-central-1
BEDROCK_VISION_MODEL_ID=
BEDROCK_TEXT_MODEL_ID=

# Olaylar (inline | sqs)
EVENT_MODE=inline
AGENT_QUEUE_URL=

# Link kontrolü (mock | http)
LINK_CHECK_MODE=mock

# Finans
HOLD_DAYS=14
MIN_PAYOUT_KURUS=50000
# Banka talimat dosyasındaki borçlu (ajans) hesabı — pain.001 XML
AGENCY_NAME=Infulancer Ajans
AGENCY_IBAN=TR000000000000000000000000
AGENCY_BIC=NOTPROVIDED

APP_URL=http://localhost:3000
