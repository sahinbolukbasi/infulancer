// Influencer Ajans Yönetim Platformu — veri modeli.
// Kural: bakiye hiçbir yerde kolon olarak tutulmaz; LedgerEntry'den türetilir.
// LedgerEntry ve MetricSnapshot üzerinde UPDATE/DELETE trigger ile engellenir.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────── Enums ─────────────

enum Role {
  ADMIN
  /// Ajans çalışanı: operasyon yetkisi, kullanıcı/yetki/finans/sistem ayarı yok
  AGENCY
  BRAND
  INFLUENCER
}

enum UserStatus {
  ACTIVE
  PENDING
  REJECTED
  SUSPENDED
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TaxStatus {
  FATURA
  SERBEST_MESLEK_MAKBUZU
  STOPAJLI
}

enum Platform {
  INSTAGRAM
  TIKTOK
  YOUTUBE
}

enum ContentType {
  // Instagram
  REELS
  STORY
  CAROUSEL
  FEED
  LIVE
  // TikTok (LIVE ortak)
  VIDEO
  PHOTO
  // YouTube (VIDEO ortak)
  SHORTS
  COMMUNITY
}

enum CampaignStatus {
  TASLAK
  AKTIF
  KAPANDI
  IPTAL
}

enum ContractStatus {
  TEKLIF
  KABUL
  RED
}

enum DeliverableStatus {
  TASLAK
  ATANDI
  BRIEF_GONDERILDI
  ICERIK_YUKLENDI
  REVIZYON
  ONAYLANDI
  YAYINLANDI
  METRIK_BEKLIYOR
  TAMAMLANDI
  IPTAL
}

enum ReviewDecision {
  ONAY
  REVIZYON
}

enum AssetKind {
  BRIEF_PDF
  MARKA_LOGO
  MARKA_FONT
  ORNEK_CEKIM
  URUN_FOTO
  ONAYLI_CAPTION
  TASLAK
  HAM_DOSYA
  METRIK_SS
  DIGER
}

enum AssetDirection {
  AJANS_TO_INFLUENCER
  INFLUENCER_TO_AJANS
}

enum UsageChannel {
  ORGANIK
  PAID_DAHIL
}

enum UploadStatus {
  BEKLIYOR
  TAMAM
}

enum MetricStage {
  H24
  D7
  D30
  ARA
}

enum MetricSource {
  MANUEL
  EKRAN_GORUNTUSU
  API
  MARKA
}

enum AgentCheck {
  BRIEF_UYUM
  YAYIN_KONTROL
  SILINME_KONTROL
  METRIK_TUTARLILIK
  SAHTE_ETKILESIM
  HEDEF_PROJEKSIYON
  KAMPANYA_OZETI
  INFLUENCER_ONERI
  MARKA_CAKISMASI
  STORY_HATIRLATMA
}

enum Severity {
  BILGI
  UYARI
  KRITIK
}

enum AgentRunStatus {
  ACIK
  ONAYLANDI
  EZILDI
}

enum LedgerAccount {
  INFLUENCER_PAYABLE
  AGENCY_EXPENSE
  AGENCY_BANK
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum LedgerReason {
  HAKEDIS
  ODEME
  DUZELTME
}

enum PayoutStatus {
  TALEP_EDILDI
  ONAYLANDI
  ODEME_LISTESINDE
  GONDERILDI
  REDDEDILDI
}

// ───────────── Kimlik ─────────────

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  name         String
  role         Role
  /// Davetle kayıt olanlar admin onayına kadar PENDING; mevcut kullanıcılar ACTIVE.
  status       UserStatus  @default(ACTIVE)
  phone        String?
  /// Kullanıcının yüklediği profil fotoğrafı (S3 anahtarı). Yoksa influencer sosyal hesabından türetilir.
  avatarKey    String?
  brandId      String?
  brand        Brand?      @relation(fields: [brandId], references: [id], onDelete: SetNull)
  influencerId String?     @unique
  influencer   Influencer? @relation(fields: [influencerId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  notifications        Notification[]
  briefsCreated        CampaignBrief[]
  statusChanges        DeliverableStatusChange[]
  reviews              DeliverableReview[]
  assetsUploaded       Asset[]
  metricsEntered       MetricSnapshot[]
  agentRunsResolved    AgentRun[]
  payoutBatches        PayoutBatch[]
  invitesCreated       Invite[]                  @relation("InviteCreatedBy")
  application          SignupApplication?        @relation("ApplicationUser")
  applicationsReviewed SignupApplication[]       @relation("ApplicationReviewer")

  @@index([brandId])
}

// ───────────── Marka / Influencer ─────────────

model Brand {
  id                 String    @id @default(cuid())
  name               String
  taxOffice          String
  taxNumber          String
  contactName        String
  contactEmail       String
  contactPhone       String
  contractRef        String?
  contractStartsAt   DateTime?
  category           String
  competitorBrandIds String[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  users          User[]
  campaigns      Campaign[]
  tenantSettings TenantSettings?
  categories     BrandCategory[]
}

model Influencer {
  id               String    @id @default(cuid())
  name             String
  category         String
  iban             String
  ibanHolder       String
  taxStatus        TaxStatus
  canIssueInvoice  Boolean
  audienceTimezone String    @default("Europe/Istanbul")
  city             String?
  bio              String?
  /// Vitrin: markalara görünen kısa başlık ve görünürlük tercihleri (influencer yönetir)
  headline           String?
  /// Influencer'ın yüklediği profil fotoğrafı (S3 anahtarı); sosyal senkron avatarını ezer.
  avatarKey          String?
  showcaseVisible    Boolean   @default(true)
  showCollaborations Boolean   @default(true)
  showPrices         Boolean   @default(true)
  riskScore        Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user           User?
  socialAccounts SocialAccount[]
  assignments    Assignment[]
  ledgerEntries  LedgerEntry[]
  payoutRequests PayoutRequest[]
  taxProfile     InfluencerTaxProfile?
  categories     InfluencerCategory[]
}

model SocialAccount {
  id             String     @id @default(cuid())
  influencerId   String
  influencer     Influencer @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  platform       Platform
  handle         String
  followers      Int
  engagementRate Decimal    @db.Decimal(6, 4)
  demographics   Json
  /// Senkron: manual | instagram_business_discovery | youtube_data | tiktok_oauth
  syncSource     String     @default("manual")
  externalId     String?
  profileUrl     String?
  avatarUrl      String?
  postsCount     Int?
  avgLikes       Int?
  avgComments    Int?
  avgViews       Int?
  verified       Boolean    @default(false)
  /// TikTok OAuth token'ı kasada (Secrets Manager); burada yalnız referans
  tokenRef       String?
  lastSyncedAt   DateTime?
  syncError      String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  snapshots SocialAccountSnapshot[]

  @@unique([influencerId, platform])
}

model SocialAccountSnapshot {
  id              String        @id @default(cuid())
  socialAccountId String
  socialAccount   SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  followers       Int
  engagementRate  Decimal       @db.Decimal(6, 4)
  demographics    Json
  takenAt         DateTime

  @@index([socialAccountId, takenAt])
}

// ───────────── Kampanya ─────────────

model Campaign {
  id                     String         @id @default(cuid())
  brandId                String
  brand                  Brand          @relation(fields: [brandId], references: [id], onDelete: Restrict)
  name                   String
  slug                   String         @unique
  budgetKurus            BigInt
  brandTotalFeeKurus     BigInt
  startsAt               DateTime
  endsAt                 DateTime
  /// [{kpi, target, weight, windowDays}] — zod ile doğrulanır (domain/campaign-score.ts)
  targets                Json
  status                 CampaignStatus @default(TASLAK)
  closedAt               DateTime?
  brandPaymentReceivedAt DateTime?
  reportSummary          String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  briefs      CampaignBrief[]
  assignments Assignment[]
  assets      Asset[]

  @@index([brandId])
  @@index([status])
}

model CampaignBrief {
  id                 String   @id @default(cuid())
  campaignId         String
  campaign           Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  version            Int
  text               String
  dos                String[]
  donts              String[]
  hashtags           String[]
  mentions           String[]
  requiredPhrases    String[]
  bannedPhrases      String[]
  disclosureRequired Boolean
  createdById        String
  createdBy          User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt          DateTime @default(now())

  @@unique([campaignId, version])
}

model Assignment {
  id                     String         @id @default(cuid())
  campaignId             String
  campaign               Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  influencerId           String
  influencer             Influencer     @relation(fields: [influencerId], references: [id], onDelete: Restrict)
  feeKurus               Int
  commissionKurus        Int
  contractStatus         ContractStatus @default(TEKLIF)
  exclusivityDays        Int            @default(0)
  exclusivityCategory    String?
  couponCode             String?
  conflictOverrideReason String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  deliverables Deliverable[]

  @@index([campaignId])
  @@index([influencerId])
}

// ───────────── Deliverable (atomik birim) ─────────────

model Deliverable {
  id                      String            @id @default(cuid())
  assignmentId            String
  assignment              Assignment        @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  platform                Platform
  contentType             ContentType
  /// UTC olarak saklanır; influencer kitlesinin saat diliminde gösterilir.
  plannedAt               DateTime
  approvalDeadline        DateTime
  status                  DeliverableStatus @default(TASLAK)
  postUrl                 String?
  publishedAt             DateTime?
  caption                 String?
  hashtags                String[]
  mentions                String[]
  link                    String?
  disclosureRequired      Boolean
  contractViolation       Boolean           @default(false)
  /// md. 23/A: story serisinde kare sayısı (kontrol kare başına), platform açıklama toggle'ları
  frameCount              Int               @default(1)
  frameTexts              String[]
  paidPartnershipToggle   Boolean           @default(false)
  commercialContentToggle Boolean           @default(false)
  spokenDisclosure        Boolean           @default(false)
  hasAudio                Boolean           @default(false)
  isLive                  Boolean           @default(false)
  /// Kullanım hakkı (Türkiye'de faturayı değiştirir): süre, mecra, coğrafya
  usageRightsDays         Int?
  usageRightsChannel      UsageChannel?
  usageRightsGeo          String[]
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  statusChanges   DeliverableStatusChange[]
  reviews         DeliverableReview[]
  assets          Asset[]
  metricSnapshots MetricSnapshot[]

  @@index([assignmentId])
  @@index([plannedAt, status])
}

model DeliverableStatusChange {
  id            String             @id @default(cuid())
  deliverableId String
  deliverable   Deliverable        @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  from          DeliverableStatus?
  to            DeliverableStatus
  byUserId      String?
  byUser        User?              @relation(fields: [byUserId], references: [id], onDelete: SetNull)
  note          String?
  at            DateTime           @default(now())

  @@index([deliverableId, at])
}

model DeliverableReview {
  id            String         @id @default(cuid())
  deliverableId String
  deliverable   Deliverable    @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  brandUserId   String
  brandUser     User           @relation(fields: [brandUserId], references: [id], onDelete: Restrict)
  decision      ReviewDecision
  note          String
  createdAt     DateTime       @default(now())

  @@index([deliverableId])
}

// ───────────── Dosyalar ─────────────

model Asset {
  id                String         @id @default(cuid())
  deliverableId     String?
  deliverable       Deliverable?   @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  campaignId        String?
  campaign          Campaign?      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  key               String         @unique
  fileName          String
  mime              String
  size              Int
  kind              AssetKind
  direction         AssetDirection
  usageDurationDays Int?
  usageEndsAt       DateTime?
  usageChannel      UsageChannel?
  usageGeography    String[]
  uploadedById      String
  uploadedBy        User           @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  uploadStatus      UploadStatus   @default(BEKLIYOR)
  createdAt         DateTime       @default(now())

  metricSnapshots MetricSnapshot[]

  @@index([deliverableId])
  @@index([campaignId])
}

// ───────────── Metrikler (append-only) ─────────────

model MetricSnapshot {
  id                String       @id @default(cuid())
  deliverableId     String
  deliverable       Deliverable  @relation(fields: [deliverableId], references: [id], onDelete: Restrict)
  stage             MetricStage
  source            MetricSource
  measuredAt        DateTime
  reach             Int?
  impressions       Int?
  likes             Int?
  comments          Int?
  saves             Int?
  shares            Int?
  clicks            Int?
  sales             Int?
  revenueKurus      Int?
  /// Platforma özgü metrikler — domain/platform-rules.ts şemalarıyla doğrulanır.
  platformMetrics   Json
  screenshotAssetId String?
  screenshotAsset   Asset?       @relation(fields: [screenshotAssetId], references: [id], onDelete: Restrict)
  enteredById       String?
  enteredBy         User?        @relation(fields: [enteredById], references: [id], onDelete: SetNull)
  createdAt         DateTime     @default(now())

  @@index([deliverableId, measuredAt])
  @@index([screenshotAssetId])
}

// ───────────── Agent ─────────────

model AgentRun {
  id             String         @id @default(cuid())
  targetType     String
  targetId       String
  checkType      AgentCheck
  findings       Json
  summary        String
  severity       Severity
  status         AgentRunStatus @default(ACIK)
  model          String
  promptVersion  String
  /// check:targetType:targetId:bucket
  idempotencyKey String         @unique
  resolvedById   String?
  resolvedBy     User?          @relation(fields: [resolvedById], references: [id], onDelete: SetNull)
  resolutionNote String?
  createdAt      DateTime       @default(now())
  resolvedAt     DateTime?

  @@index([status, severity])
  @@index([targetType, targetId])
}

// ───────────── Finans (çift kayıt, append-only) ─────────────

model LedgerEntry {
  id            String          @id @default(cuid())
  /// Aynı olayın borç/alacak çifti aynı txId'yi taşır.
  txId          String
  account       LedgerAccount
  influencerId  String?
  influencer    Influencer?     @relation(fields: [influencerId], references: [id], onDelete: Restrict)
  amountKurus   Int
  direction     LedgerDirection
  reason        LedgerReason
  referenceType String
  referenceId   String
  availableAt   DateTime?
  createdAt     DateTime        @default(now())

  @@index([txId])
  @@index([influencerId])
  @@index([referenceType, referenceId])
}

model PayoutRequest {
  id                 String       @id @default(cuid())
  influencerId       String
  influencer         Influencer   @relation(fields: [influencerId], references: [id], onDelete: Restrict)
  amountKurus        Int
  status             PayoutStatus @default(TALEP_EDILDI)
  ibanSnapshot       String
  ibanHolderSnapshot String
  adminNote          String?
  batchId            String?
  batch              PayoutBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  approvedAt         DateTime?
  sentAt             DateTime?
  rejectedAt         DateTime?

  @@index([influencerId])
  @@index([batchId])
  @@index([status])
}

model PayoutBatch {
  id          String   @id @default(cuid())
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  format      String
  createdAt   DateTime @default(now())

  requests PayoutRequest[]

  @@index([createdById])
}

// ───────────── Bildirim ─────────────

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

// ═════════════ EK MODÜL: Kanallar, Agent'lar, Reklam, Creative, Uyum ═════════════
// tenant = Brand (tenantId = Brand.id). Tenant kapsamlı tablolarda RLS politikası vardır
// (migration SQL); kapsamlı okumalar src/tenancy.ts withTenant() üzerinden yapılır.

enum ChannelProvider {
  WHATSAPP
  INSTAGRAM
  MESSENGER
  TIKTOK
  META_ADS
}

enum ConnectionStatus {
  PENDING
  ACTIVE
  REVOKED
  ERROR
}

enum PaymentMethodState {
  payment_method_pending
  payment_method_confirmed
}

enum ConversationStatus {
  open
  awaiting_human
  assigned
  closed
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum TemplateStatus {
  IN_REVIEW
  REJECTED
  ACTIVE
  PAUSED
  DISABLED
  APPEAL_REQUESTED
}

enum TemplateQuality {
  PENDING
  HIGH
  MEDIUM
  LOW
}

enum TemplateCategory {
  marketing
  utility
  authentication
}

enum MessageCategory {
  marketing
  utility
  authentication
  service
  meta_business_agent
}

enum ConsentChannel {
  MESAJ
  EPOSTA
  ARAMA
}

enum ConsentState {
  ONAY
  RET
}

enum TenantMode {
  sandbox
  production
}

enum TaxProfileStatus {
  istisna_20b
  kayitli_mukellef
  diger
}

enum LicenseStatus {
  cleared
  pending
  restricted
}

enum ModelStatus {
  active
  deprecated
  retired
}

enum CreativeJobStatus {
  HELD
  IN_QUEUE
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
  REJECTED
}

enum OutOfHoursBehavior {
  queue
  auto_reply_then_queue
}

/// Basit anahtar/değer yapılandırma (tatil takvimi, kota limitleri, model ID'leri, kademeler).
model ConfigValue {
  key       String   @id
  value     Json
  note      String?
  verified  Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@map("config_values")
}

/// Tenant (marka) ayarları ve uyum modu.
model TenantSettings {
  tenantId                 String     @id
  brand                    Brand      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mode                     TenantMode @default(sandbox)
  messageRetentionDays     Int        @default(90)
  marketingMaxPriceUsd     Decimal?   @db.Decimal(10, 5)
  prohibitedVerticalAck    Boolean    @default(false)
  prohibitedVerticalAt     DateTime?
  businessVerificationHelp Boolean    @default(false)
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt

  @@map("tenant_settings")
}

model TenantPolicyFlag {
  id        String   @id @default(cuid())
  tenantId  String
  flag      String
  detail    String?
  blocking  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([tenantId, flag])
  @@map("tenant_policy_flags")
}

model ChannelConnection {
  id             String           @id @default(cuid())
  tenantId       String
  provider       ChannelProvider
  externalIds    Json             @map("external_ids")
  tokenRef       String           @map("token_ref")
  scopes         String[]
  status         ConnectionStatus @default(PENDING)
  connectedAt    DateTime?        @map("connected_at")
  lastVerifiedAt DateTime?        @map("last_verified_at")
  revokedAt      DateTime?        @map("revoked_at")
  lastError      String?
  createdAt      DateTime         @default(now())

  phoneNumbers WhatsAppNumber[]

  @@index([tenantId])
  @@map("channel_connections")
}

/// Tenant başına TEK WhatsApp numarası (aylık 1.000 ücretsiz servis mesajı numara başınadır).
model WhatsAppNumber {
  id                  String             @id @default(cuid())
  tenantId            String             @unique
  connectionId        String
  connection          ChannelConnection  @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  wabaId              String
  phoneNumberId       String             @unique
  displayNumber       String?
  businessPortfolioId String?
  pinCiphertext       String?
  paymentMethod       PaymentMethodState @default(payment_method_pending)
  callingEnabled      Boolean            @default(false)
  messagingLimit      String             @default("TIER_250")
  qualityRating       String?
  throughputLevel     String?
  onboardingStep      String             @default("signup")
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@map("whatsapp_numbers")
}

model WebhookDedupe {
  messageId String   @id @map("message_id")
  provider  String
  ttl       DateTime
  createdAt DateTime @default(now())

  @@index([ttl])
  @@map("webhook_dedupe")
}

model RawWebhook {
  id          String    @id @default(cuid())
  provider    String
  s3Key       String
  tenantId    String?
  processedAt DateTime?
  error       String?
  receivedAt  DateTime  @default(now())

  @@index([processedAt])
  @@map("raw_webhooks")
}

model Contact {
  id         String          @id @default(cuid())
  tenantId   String
  channel    ChannelProvider
  externalId String
  phoneE164  String?
  email      String?
  name       String?
  country    String?
  isMinor    Boolean         @default(false)
  createdAt  DateTime        @default(now())

  conversations Conversation[]

  @@unique([tenantId, channel, externalId])
  @@map("contacts")
}

model Conversation {
  id                        String             @id @default(cuid())
  tenantId                  String
  channel                   ChannelProvider
  contactId                 String
  contact                   Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  status                    ConversationStatus @default(open)
  assignedUserId            String?
  tags                      String[]
  serviceWindowExpiresAt    DateTime?          @map("service_window_expires_at")
  fepWindowExpiresAt        DateTime?          @map("fep_window_expires_at")
  humanAgentWindowExpiresAt DateTime?          @map("human_agent_window_expires_at")
  lastInboundAt             DateTime?
  slaStartedAt              DateTime?
  agentKey                  String?
  agentTurns                Int                @default(0)
  aiChargeable              Boolean            @default(true)
  handoffReason             String?
  windowWarningSentAt       DateTime?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt

  messages Message[]

  @@index([tenantId, status])
  @@map("conversations")
}

model Message {
  id             String           @id @default(cuid())
  tenantId       String
  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  externalId     String?
  direction      MessageDirection
  body           String?
  templateId     String?
  category       MessageCategory?
  mediaS3Key     String?
  mediaUrl       String?
  status         String?
  statusAt       DateTime?
  fromAi         Boolean          @default(false)
  createdAt      DateTime         @default(now())

  @@unique([tenantId, externalId])
  @@index([conversationId, createdAt])
  @@map("messages")
}

/// Analitik agregasyon (günlük mesaj sayıları); purge mesajın katkısını düşer.
model MessageDailyStat {
  tenantId  String
  day       String
  channel   ChannelProvider
  direction MessageDirection
  count     Int              @default(0)

  @@id([tenantId, day, channel, direction])
  @@map("message_daily_stats")
}

model MessageTemplate {
  id                   String           @id @default(cuid())
  tenantId             String
  name                 String
  language             String           @default("tr")
  category             TemplateCategory
  body                 String
  containsPromotion    Boolean          @default(false)
  status               TemplateStatus   @default(IN_REVIEW)
  quality              TemplateQuality  @default(PENDING)
  pauseCount           Int              @default(0)
  pausedUntil          DateTime?
  sendRateFactor       Decimal          @default(1) @db.Decimal(4, 2)
  readRate             Decimal?         @db.Decimal(5, 4)
  blockRate            Decimal?         @db.Decimal(5, 4)
